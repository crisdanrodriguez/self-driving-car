# Example environment variables
# Copy this to .env and adjust values as needed

# Model Configuration
MODEL_PATH=model.h5
MODEL_WEIGHTS=model_weights.h5
INPUT_SHAPE=66,200,3

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=4567
DEBUG=False

# Model Parameters
MAX_SPEED=30
STEERING_SMOOTHING=0.9

# Data Configuration
DATA_PATH=data/driving_log.csv
IMAGE_PATH=data/IMG/

# Training Configuration
EPOCHS=5
BATCH_SIZE=64
VALIDATION_SPLIT=0.2
LEARNING_RATE=0.0001

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/training.log

# Hardware
USE_GPU=True
GPU_MEMORY_FRACTION=0.5
NUM_WORKERS=4
