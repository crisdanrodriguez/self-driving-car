# Auto normalize line endings for all text files
* text=auto

# Python
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf
*.pyi text eol=lf

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.com text eol=crlf
*.exe binary

# Jupyter Notebook
*.ipynb text eol=lf diff=jupyternotebook

# Text files
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files
*.h5 binary
*.pkl binary
*.pickle binary
*.pyc binary
*.pyo binary
*.so binary
*.exe binary
*.dll binary
*.dylib binary

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.tif binary
*.tiff binary

# Media
*.mp4 binary
*.avi binary
*.mov binary
